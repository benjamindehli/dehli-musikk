rules_version = '2';

// Nothing uses Firebase Storage; the site's images ship with the export and are
// served by Hosting. Denied for the same reason as firestore.rules, and deployed
// the same way: firebase deploy --only firestore:rules,storage
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
