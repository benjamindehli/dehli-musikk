{
    "name": "dehli-musikk",
    "version": "2.21.1",
    "private": true,
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.6",
        "prettier": "^3.10.0",
        "sass": "^1.108.2",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "dev": "next dev",
        "admin": "next dev admin --hostname 127.0.0.1 --port 3100",
        "admin:typecheck": "tsc --noEmit -p admin",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "verify:thumbnails": "node scripts/verify-110-thumbnails.mjs",
        "verify:albums": "node scripts/verify-release-albums.mjs",
        "verify:markup": "node scripts/verify-markup-assets.mjs",
        "verify:markdown": "node scripts/verify-markdown.mjs",
        "verify:links": "node scripts/verify-internal-links.mjs",
        "verify:images": "node scripts/verify-product-gallery.mjs",
        "verify:skills": "node scripts/agent-skills.mjs --check",
        "images:products": "node scripts/generate-product-images.mjs",
        "indexnow": "node scripts/indexnow.mjs",
        "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
        "verify": "yarn verify:thumbnails && yarn verify:albums && yarn verify:images",
        "skills:build": "node scripts/agent-skills.mjs",
        "worker:test": "node --test \"worker/test/*.test.mjs\"",
        "deploy:install": "npm ci --prefix deploy --ignore-scripts --no-audit --no-fund",
        "worker:dev": "deploy/node_modules/.bin/wrangler dev --config worker/wrangler.jsonc",
        "worker:deploy": "deploy/node_modules/.bin/wrangler deploy --config worker/wrangler.jsonc"
    },
    "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
